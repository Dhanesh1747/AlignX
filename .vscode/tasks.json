{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Spring Boot Backend",
      "type": "shell",
      "command": "mvn clean spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/alignx_backend"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run AlignX (One-Click)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File .\\run-alignx.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
